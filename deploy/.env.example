# Copy to .env and provide unique local values. Never commit the populated file.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/facturacion
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
APP_CORS_ALLOWED_ORIGINS=http://localhost
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
APP_CRYPTO_SECRET=CHANGE_ME_USE_A_DIFFERENT_RANDOM_SECRET
FACTUS_URL=https://api-sandbox.factus.com.co
FACTUS_USERNAME=CHANGE_ME
FACTUS_PASSWORD=CHANGE_ME
FACTUS_CLIENTID=CHANGE_ME
FACTUS_CLIENTSECRET=CHANGE_ME
FACTUS_PREFIJO=CHANGE_ME
ESTABLECIMIENTO_NOMBRE=Establecimiento de prueba
ESTABLECIMIENTO_NIT=CHANGE_ME
ESTABLECIMIENTO_DIRECCION=CHANGE_ME
ESTABLECIMIENTO_TELEFONO=CHANGE_ME
ESTABLECIMIENTO_EMAIL=CHANGE_ME
ESTABLECIMIENTO_MUNICIPALY=CHANGE_ME
SUPERADMIN_NOMBRE=Super Administrador
SUPERADMIN_USERNAME=CHANGE_ME
SUPERADMIN_PASSWORD=CHANGE_ME
SUPERADMIN_EMAIL=admin@example.invalid
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_URL=
