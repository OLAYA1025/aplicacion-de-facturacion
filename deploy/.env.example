DIAN_CERTIFICATE_PASSWORD=CHANGE_ME
DIAN_CERTIFICATE_ALIAS=CHANGE_ME
LOGOS_HOST_DIRECTORY=./logos
TIRILLA_FACTURA_LOGO_DIRECTORY=/logos
BACKUP_HOST_DIRECTORY=./backups-data
